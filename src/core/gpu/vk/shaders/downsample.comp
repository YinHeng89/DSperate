#version 450
// Native-resolution planes from the hi-res ones (S >= 2): one invocation per
// native pixel, top-left subpixel, no filter (a filtered colour would be
// invented where the DS's own layer is expected).
#extension GL_GOOGLE_include_directive : require
#define DS_GLSL 1
#include "vk_layout.h"
layout(local_size_x = 64) in;
layout(std430, binding = 4) readonly buffer Out { uint fb[]; };        // hi-res layer, 256S x 192S
layout(std430, binding = 12) writeonly buffer Nat { uint nat[]; };    // 256 x 192
layout(push_constant) uniform Push { GpuFrame f; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= 256u * 192u) return;
  uint x = i % 256u, y = i / 256u, S = pc.f.scale;
  uint j = (y * S) * (256u * S) + x * S;
  nat[i] = fb[j];
}
