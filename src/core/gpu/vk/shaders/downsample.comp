#version 450
// Native-resolution planes from the hi-res ones (S >= 2): one invocation per
// native pixel, top-left subpixel, no filter (a filtered colour would be
// invented where the DS's own layer is expected). DS_FF_SHRINK3 also shrinks
// attribute and depth for the native-resolution translucent tail.
#extension GL_GOOGLE_include_directive : require
#define DS_GLSL 1
#include "vk_layout.h"
layout(local_size_x = 64) in;
layout(std430, binding = 4) readonly buffer Out { uint fb[]; };        // hi-res layer, 256S x 192S
layout(std430, binding = 6) readonly buffer Depth { uint zbuf[]; };
layout(std430, binding = 7) readonly buffer Attr { uint abuf[]; };
layout(std430, binding = 12) writeonly buffer Nat { uint nat[]; };    // 256 x 192
layout(std430, binding = 14) writeonly buffer NatAttr { uint natattr[]; };
layout(std430, binding = 15) writeonly buffer NatZ { uint natz[]; };
layout(push_constant) uniform Push { GpuFrame f; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= 256u * 192u) return;
  uint x = i % 256u, y = i / 256u, S = pc.f.scale;
  uint j = (y * S) * (256u * S) + x * S;
  nat[i] = fb[j];
  if ((pc.f.flags & DS_FF_SHRINK3) != 0u) { natattr[i] = abuf[j]; natz[i] = zbuf[j]; }
}
