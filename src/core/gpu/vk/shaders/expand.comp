#version 450
// After the native-resolution translucent tail: every hi-res pixel whose
// native parent the tail wrote (the touched plane) takes the parent's
// colour, attribute and depth records, so the final pass (fog, edge
// marking) and the display see one picture. The tail's alpha edges land on
// native pixels over hi-res geometry: the accepted trade for a tail that
// costs a quarter of the fragments.
#extension GL_GOOGLE_include_directive : require
#define DS_GLSL 1
#include "vk_layout.h"
layout(local_size_x = 64) in;
layout(std430, binding = 4) buffer Out { uint fb[]; };
layout(std430, binding = 6) buffer Depth { uint zbuf[]; };
layout(std430, binding = 7) buffer Attr { uint abuf[]; };
layout(std430, binding = 12) readonly buffer Nat { uint nat[]; };
layout(std430, binding = 14) readonly buffer NatAttr { uint natattr[]; };
layout(std430, binding = 15) readonly buffer NatZ { uint natz[]; };
layout(std430, binding = 16) readonly buffer Touch { uint touch[]; };
layout(push_constant) uniform Push { GpuFrame f; } pc;
void main() {
  uint S = pc.f.scale, W = 256u * S;
  uint i = gl_GlobalInvocationID.x;
  if (i >= W * 192u * S) return;
  uint x = i % W, y = i / W;
  uint p = (y / S) * 256u + x / S;
  if (touch[p] == 0u) return;
  fb[i] = nat[p]; abuf[i] = natattr[p]; zbuf[i] = natz[p];
}
