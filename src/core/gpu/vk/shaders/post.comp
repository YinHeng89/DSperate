#version 450
// glslc enables this implicitly; glslangValidator needs it spelled out.
#extension GL_GOOGLE_include_directive : require
// The final pass: edge marking, then fog.
//
// Why it is a pass of its own and not part of the raster: edge marking
// compares a pixel's polygon id and depth against its four NEIGHBOURS, and in
// a tiled raster three of those four are in other workgroups. Fog needs no
// neighbour at all and could have been folded into the raster -- but the
// hardware applies edge marking first and fog to its result, so they belong
// together in that order. This is Renderer3D::final_pass_ref transcribed,
// minus the anti-aliasing arm, which is still host-gated.
//
// It runs only when DISP3DCNT asks for one of them. The raster writes its
// depth and attribute planes only in that case too, so a frame with neither
// pays nothing for this existing.
#define DS_GLSL 1
#include "vk_layout.h"

layout(local_size_x = 64) in;

layout(std430, binding = 4)          buffer Out   { uint fb[]; };
layout(std430, binding = 5) readonly buffer Post  { GpuPost ps; };
layout(std430, binding = 6) readonly buffer Depth { uint zbuf[]; };
layout(std430, binding = 7)          buffer Attr  { uint abuf[]; };
layout(std430, binding = 17)          buffer UCol  { uint ucol[]; };    // the pixel underneath (the exact anti-aliasing pass, DS_FF_AA); the scratch plane of the fast one
layout(std430, binding = 18) readonly buffer UAttr { uint uattr[]; };
layout(std430, binding = 19) readonly buffer UZ    { uint uz[]; };
// The smooth filter's edge plane (DS_FF2_SMOOTH), for the present stage's
// composite alone: per edge pixel the UNBLENDED pixel (RGB666 in bits 0-17,
// alpha in 18-22) and its edge record (coverage 23-27, right run 28, X-major
// 29, covered half is the top 30), bit 31 set; 0 elsewhere. The layer itself
// (fb) still gets the anti-aliasing blend: the CPU composite, display
// capture and save states read it, and a frame the present stage does not
// composite would otherwise show hard edges.
layout(std430, binding = 20) writeonly buffer Edge { uint edge[]; };
layout(push_constant) uniform Push { GpuFrame f; } pc;

// 15-bit colour channel -> 6 bits: bits 1-5 of the field, +1 when non-zero.
uint c15_to_18(uint c, uint shift) {
  uint v = ((shift == 0u ? (c << 1) : (c >> shift)) & 0x3Eu);
  return v != 0u ? v + 1u : v;
}

// Renderer3D::fog_density. The (z - offset) >> 2 << shift can wrap in 32 bits
// for large shifts, as it does on hardware, so this is unsigned throughout and
// deliberately unguarded.
uint fog_density(uint z) {
  uint id, frac;
  if (z < ps.fog_offset) { id = 0u; frac = 0u; }
  else {
    uint v = z - ps.fog_offset;
    v = (v >> 2) << ps.fog_shift;
    id = v >> 17;
    if (id >= 32u) { id = 32u; frac = 0u; } else frac = v & 0x1FFFFu;
  }
  uint d = ((ps.density[id] * (0x20000u - frac)) + (ps.density[id + 1u] * frac)) >> 17;
  return d >= 127u ? 128u : d;
}

uint fog_apply(uint color, uint d, uint fc, uint fa, bool fogcolor) {
  uint r = color & 0x3Fu, g = (color >> 8) & 0x3Fu, b = (color >> 16) & 0x3Fu, a = (color >> 24) & 0x1Fu;
  if (fogcolor) {
    r = ((c15_to_18(fc, 0u) * d) + (r * (128u - d))) >> 7;
    g = ((c15_to_18(fc, 4u) * d) + (g * (128u - d))) >> 7;
    b = ((c15_to_18(fc, 9u) * d) + (b * (128u - d))) >> 7;
  }
  a = ((fa * d) + (a * (128u - d))) >> 7;
  return r | (g << 8) | (b << 16) | (a << 24);
}

void main() {
  int W = 256 * int(pc.f.scale), H = 192 * int(pc.f.scale);
  uint i = gl_GlobalInvocationID.x;
  if (i >= uint(W * H)) return;
  int x = int(i) % W, y = int(i) / W;

  uint color = fb[i];
  uint attr  = abuf[i];
  uint z     = zbuf[i];
  bool fast = (pc.f.flags & DS_FF_AAFAST) != 0u;
  if (fast && (pc.f.flags & DS_FF_POST2) != 0u) {
    // Stage 2 of the fast anti-aliasing: stage 1 left every pixel fogged and
    // edge-marked in the scratch plane; an edge pixel now blends with its
    // outside neighbour there -- the pixel the DS's under layer holds in
    // almost every case -- by its coverage.
    color = ucol[i];
    if ((attr & 0xFu) != 0u) {
      uint cov = (attr >> 8) & 0x1Fu;
      if (cov != 0x1Fu) {
        int nx = x, ny = y;
        if ((attr & 1u) != 0u) nx = x - 1; else if ((attr & 2u) != 0u) nx = x + 1; else if ((attr & 4u) != 0u) ny = y - 1; else ny = y + 1;
        uint under = (nx < 0 || nx >= W || ny < 0 || ny >= H) ? pc.f.clear_color : ucol[uint(ny * W + nx)];
        if (cov == 0u) color = under;
        else {
          uint tr = color & 0x3Fu, tg = (color >> 8) & 0x3Fu, tb = (color >> 16) & 0x3Fu, ta = (color >> 24) & 0x1Fu;
          uint br = under & 0x3Fu, bg = (under >> 8) & 0x3Fu, bb = (under >> 16) & 0x3Fu, ba = (under >> 24) & 0x1Fu;
          ++cov;
          if (ba > 0u) {
            tr = ((tr * cov) + (br * (32u - cov))) >> 5;
            tg = ((tg * cov) + (bg * (32u - cov))) >> 5;
            tb = ((tb * cov) + (bb * (32u - cov))) >> 5;
          }
          ta = ((ta * cov) + (ba * (32u - cov))) >> 5;
          color = tr | (tg << 8) | (tb << 16) | (ta << 24);
        }
      }
    }
    fb[i] = color;
    return;
  }

  if ((pc.f.dispcnt & (1u << 5)) != 0u && (attr & 0xFu) != 0u) {
    // Edge marking, against the four neighbours. Off the screen the CPU reads
    // the ring's border rows, which the clear fills with the clear colour's
    // polygon id and the clear depth -- so that is what a neighbour outside
    // the frame is here, rather than a special case.
    uint id = attr >> 24;
    bool mark = false;
    for (int k = 0; k < 4; ++k) {
      int nx = x + (k == 0 ? -1 : (k == 1 ? 1 : 0));
      int ny = y + (k == 2 ? -1 : (k == 3 ? 1 : 0));
      uint na, nz;
      if (nx < 0 || nx >= W || ny < 0 || ny >= H) { na = pc.f.clear_attr; nz = pc.f.clear_depth; }
      else { uint j = uint(ny * W + nx); na = abuf[j]; nz = zbuf[j]; }
      if (id != (na >> 24) && z < nz) { mark = true; break; }
    }
    if (mark) {
      uint e = ps.edge[id >> 3];
      color = c15_to_18(e, 0u) | (c15_to_18(e, 4u) << 8) | (c15_to_18(e, 9u) << 16) |
              (color & 0xFF000000u);
      attr = (attr & 0xFFFFE0FFu) | 0x00001000u;   // coverage broken for the anti-aliasing blend (final_pass_ref)
      abuf[i] = attr;
    }
  }
  bool aa = (pc.f.flags & DS_FF_AA) != 0u && (attr & 0xFu) != 0u;
  uint under = aa ? ucol[i] : 0u;

  if ((pc.f.dispcnt & (1u << 7)) != 0u) {
    bool fogcolor = (pc.f.dispcnt & (1u << 6)) == 0u;   // clear: fog the colour too, not the alpha alone
    uint fc = ps.fog_color;
    uint fa = (fc >> 16) & 0x1Fu;
    if ((attr & (1u << 15)) != 0u) color = fog_apply(color, fog_density(z), fc, fa, fogcolor);
    if (aa && (uattr[i] & (1u << 15)) != 0u) under = fog_apply(under, fog_density(uz[i]), fc, fa, fogcolor);   // the lower pixel feeds the blend
  }
  if (aa) {
    // Anti-aliasing: the edge pixel blended with the pixel underneath by its coverage.
    uint cov = (attr >> 8) & 0x1Fu;
    if (cov == 0u) color = under;
    else if (cov != 0x1Fu) {
      uint tr = color & 0x3Fu, tg = (color >> 8) & 0x3Fu, tb = (color >> 16) & 0x3Fu, ta = (color >> 24) & 0x1Fu;
      uint br = under & 0x3Fu, bg = (under >> 8) & 0x3Fu, bb = (under >> 16) & 0x3Fu, ba = (under >> 24) & 0x1Fu;
      ++cov;
      if (ba > 0u) {
        tr = ((tr * cov) + (br * (32u - cov))) >> 5;
        tg = ((tg * cov) + (bg * (32u - cov))) >> 5;
        tb = ((tb * cov) + (bb * (32u - cov))) >> 5;
      }
      ta = ((ta * cov) + (ba * (32u - cov))) >> 5;
      color = tr | (tg << 8) | (tb << 16) | (ta << 24);
    }
  }

  if (fast && (pc.f.flags2 & DS_FF2_SMOOTH) != 0u) {
    // The smooth filter resolves the edge itself, at panel resolution, from
    // the unblended pixel and its record; stage 2 still blends the layer.
    uint cov = (attr >> 8) & 0x1Fu;
    edge[i] = ((attr & 0xFu) != 0u && cov != 0x1Fu)
      ? ((color & 0x3Fu) | (((color >> 8) & 0x3Fu) << 6) | (((color >> 16) & 0x3Fu) << 12) | (((color >> 24) & 0x1Fu) << 18) |
         (cov << 23) | (((attr & 2u) != 0u) ? 1u << 28 : 0u) | (((attr & 0x2000u) != 0u) ? 1u << 29 : 0u) | (((attr & 0x4000u) != 0u) ? 1u << 30 : 0u) | 0x80000000u)
      : 0u;
  }
  if (fast) { ucol[i] = color; return; }   // stage 1 of the fast anti-aliasing: stage 2 reads the neighbours from here
  fb[i] = color;
}
