#version 450
// glslc enables this implicitly; glslangValidator needs it spelled out.
#extension GL_GOOGLE_include_directive : require
// Span pass: the Y stage, once per (polygon, scanline), for the whole frame.
//
// ONE LANE PER ROW over the whole frame's span table, not one workgroup per
// polygon. The first shape was one 64-lane workgroup per polygon, its lanes
// taking the polygon's scanlines in stride -- and it cost about 4 us per
// POLYGON whatever the polygon's height (RG DS Plus, DS_VK_TIMING): NSMB's
// 850 polygons average 2.4 rows, so 61 of 64 lanes idled while the workgroup
// paid its launch and its divisions, 3.35 ms of a 4.35 ms GPU frame. Here a
// frame of 2 K rows is 32 workgroups. The host writes each row's polygon
// index (rowpoly) as it lays the table out, so a lane finds its polygon with
// one load and its scanline from the polygon's first visible line.
//
// The raster used to do this itself, once per tile a polygon touched. Nothing
// about it depends on x, so those repeats were pure waste -- and they were
// also the only reason the tile SHAPE mattered.
#define DS_GLSL 1
#include "vk_layout.h"

layout(local_size_x = 64) in;

layout(std430, binding = 0)  readonly  buffer Polys   { GpuPoly polys[]; };
layout(std430, binding = 1)  readonly  buffer Verts   { GpuVert verts[]; };
layout(std430, binding = 9)  writeonly buffer Rows    { GpuRow rows[]; };
layout(std430, binding = 11) readonly  buffer RowPoly { uint rowpoly[]; };
layout(push_constant) uniform Push { GpuFrame f; } pc;

#include "ds_span.glsl"

void main() {
  uint ri = gl_GlobalInvocationID.x;
  if (ri >= pc.f.nrows) return;
  uint pi = rowpoly[ri];
  GpuPoly p = polys[pi];
  // Rows exist only for the visible part of [ytop, ybot], from max(ytop, 0);
  // every consumer uses the same clamp (render3d.cpp, bin.comp, vis.comp).
  int y = max(p.ytop, 0) + int(ri - p.row_base);
  GpuRow r = compute_row(p, y);
  r.poly = pi;
  rows[ri] = r;
}
