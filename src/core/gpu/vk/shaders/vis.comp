#version 450
// glslc enables this implicitly; glslangValidator needs it spelled out.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_atomic_int64 : require
// Visibility pass: the order-free prefix of the list, one invocation per
// DRAWN pixel of each span, with no per-pixel loop over polygons at all.
//
// Why it may ignore draw order. For an opaque-group polygon the pixel's
// final owner is a MINIMUM under a total order, and a minimum is commutative:
//   * depth mode 0 is strict less-than, so on a z tie the earlier polygon
//     keeps the pixel;
//   * depth mode 1 lets a front-facing polygon pass on a tie only against an
//     opaque back-facing destination -- so on a tie front beats back in
//     either order, and front-vs-front or back-vs-back goes to the earlier;
//   * every alpha such a polygon produces is 0 or 31 (decal: the polygon's 31;
//     modulate: the texel's, which the cache decodes to 0 or 31 for every
//     non-graded format), so it either writes the pixel outright or is
//     alpha-tested away, and never blends with what is there;
//   * an opaque write replaces colour, depth and the attribute word whole.
// The key is (z, back-facing, list index), smallest wins, packed into one
// 64-bit integer and atomicMin'd into the pixel. The clear is the key's
// initial value in effect: a fragment at or beyond clear_depth simply does
// not compete, since the clear is never back-facing and never ties its way
// in. resolve.comp then shades each pixel's winner exactly once.
//
// What this is instead of: the raster's loop, which ran every polygon binned
// to a tile past every pixel of the tile, and shaded a pixel once per
// polygon that covered it. Here the work is proportional to the pixels the
// DS actually draws, and the shading is proportional to the screen.
//
// The order-DEPENDENT part -- translucency, shadow masks, shadows -- is the
// tail of the list from first_ordered on; raster.comp still walks that in
// order, seeded from the resolve pass's output.
#define DS_GLSL 1
#include "vk_layout.h"

// DS_VIS_ROWS rows per workgroup, one DS_VIS_LANES-wide subgroup per row, the
// lanes taking the row's pixels in stride (vk_layout.h). Spans average 13-35
// pixels, so a lane takes two to five steps.
layout(local_size_x = DS_VIS_LANES, local_size_y = DS_VIS_ROWS) in;

layout(std430, binding = 0)  readonly buffer Polys  { GpuPoly polys[]; };
layout(std430, binding = 1)  readonly buffer Verts  { GpuVert verts[]; };
layout(std430, binding = 3)  readonly buffer Texels { uint texels[]; };
layout(std430, binding = 5)  readonly buffer Post   { GpuPost ps; };
layout(std430, binding = 9)  readonly buffer Rows   { GpuRow rows[]; };
layout(std430, binding = 10)          buffer Keys   { uint64_t keys[]; };
layout(push_constant) uniform Push { GpuFrame f; } pc;

#include "ds_span.glsl"
#include "ds_shade.glsl"

void main() {
  uint ri = gl_WorkGroupID.x * uint(DS_VIS_ROWS) + gl_LocalInvocationID.y;
  if (ri >= pc.f.opaque_rows) return;
  GpuRow rw = rows[ri];
  if ((rw.fl & 1u) == 0u) return;
  GpuPoly p = polys[rw.poly];
  // The row's scanline: rows are allocated for the polygon's visible lines
  // from max(ytop, 0), so the index says which.
  int py = max(p.ytop, 0) + int(ri - p.row_base);
  int W = 256 * int(pc.f.scale);

  bool front = (p.flags & DS_PF_FRONTFACING) != 0u;
  bool wbuf = (rw.fl & 8u) != 0u;
  // The alpha test can only fail on a texel of alpha 0, and only in the
  // modulate combine (blend modes 0 and 2), where the texel's alpha is the
  // pixel's; decal takes the polygon's own alpha, which is 31 here whatever
  // the texel says. So only a modulated texture that has such texels needs
  // sampling at all. (The host empties the prefix when alpha_ref is 31, and
  // wireframe is gated, so 31 always passes.)
  bool test_tex = (p.flags & (DS_PF_TEXTURED | DS_PF_TEX_ALPHA)) == (DS_PF_TEXTURED | DS_PF_TEX_ALPHA)
                  && ((p.attr >> 4) & 1u) == 0u;
  uint64_t base_key = (front ? 0ul : (1ul << 11)) | uint64_t(rw.poly);

  int xa = max(rw.xstart, 0), xb = min(rw.xend, W - 1);
  for (int px = xa + int(gl_LocalInvocationID.x); px <= xb; px += DS_VIS_LANES) {
    // The fill rules at the two ends, as raster.comp applies them.
    if (px < rw.lim0)       { if ((rw.fl & 2u) == 0u) continue; }
    else if (px >= rw.lim1) { if ((rw.fl & 4u) == 0u) continue; }

    Interp ix = row_interp(rw);
    // The per-pixel division is needed only for a W-buffered depth or for the
    // texture coordinates of an alpha-tested texel; a Z-buffered depth goes
    // through the row's reciprocal.
    if (wbuf || test_tex) interp_set_x(ix, px);
    else ix.x = px - ix.x0;

    int z = interp_z(ix, rw.zl, rw.zr);
    if (z >= int(pc.f.clear_depth)) continue;

    if (test_tex) {
      int sc = interp_val(ix, unpack_s(rw.lst), unpack_s(rw.rst));
      int tc = interp_val(ix, unpack_t(rw.lst), unpack_t(rw.rst));
      if (((sample_tex(p, sc, tc) >> 16) & 0x1Fu) == 0u) continue;
    }

    // The depth test is a SIGNED compare on both rasters (depth_pass casts
    // the stored depth to s32), so the key orders z as signed: flipping the
    // sign bit maps signed order onto unsigned.
    atomicMin(keys[uint(py * W + px)], (uint64_t(uint(z) ^ 0x80000000u) << 12) | base_key);
  }
}
