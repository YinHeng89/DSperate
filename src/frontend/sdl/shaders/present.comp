#version 450
// The GPU present stage (docs/gpu-path-scoping.md, P1): one invocation per
// PANEL pixel of the scanout buffer, imported into Vulkan as an image. The
// core writes its two 256x192 frames; this lays them out, scales, rotates
// and blends the PiP inset -- everything the CPU scanline scaler did -- so
// no panel-sized pixel passes through the CPU. First cut: nearest scaling;
// the box filter, grid, bilinear and chunky follow as P4.
layout(local_size_x = 16, local_size_y = 8) in;
layout(binding = 0, rgba8) uniform writeonly image2D dst;
layout(std430, binding = 1) readonly buffer Src { uint src[]; };   // slot base + screen * 49152 + y * 256 + x, 0xAARRGGBB
layout(std430, binding = 2) readonly buffer Comp { uint comp[]; };  // the composited screen 0 at S x, when b.w bit 31 is set
layout(std430, binding = 3) readonly buffer Over { uint over[]; };  // the frontend's overlay (OSD, menu) in the logical frame, 0xAARRGGBB; b.z bit 8 says it has content
layout(std430, binding = 4) readonly buffer Tab  { uint tab[]; };   // the LCD grid's seam bitmasks: per view, 32 words of columns then 32 of rows
layout(push_constant) uniform P {
  uvec4 a;        // presented w, h; logical w, h
  uvec4 b;        // rotation (0/90/180/270), nviews, inset alpha 0..255 | 1 << 8 (overlay drawn) | 1 << 9 (smooth 3D) | grid brightness 0..256 << 16 (256 = off), source base (words) | S << 24 | 1 << 31 when screen 0 is the composited buffer
  ivec4 rect[2];  // x, y, w, h in the logical frame, draw order
  ivec4 view[2];  // screen, shown, blends (inset), bit 0 the composited screen | bit 1 the LCD grid applies
} pc;
// The smooth-3D filter (b.z bit 9). A polygon's edge pixel carries, in the
// composited pixel's alpha byte (composite.comp's edge_byte, from the
// raster's span table), which side of the polygon it is on (bit 0: a right
// run, else a left one), whether the edge is X-major (bit 1: the coverage
// is then a vertical fraction), for those whether the covered part is the
// top of the pixel (bit 2), and the DS's 5-bit coverage (bits 3-7: how much
// of the pixel the polygon covers); 0xFF is no edge. That is enough to place the true edge inside
// the native pixel to 1/32: the panel pixels of the native pixel on the
// polygon's side keep its colour, the rest take the outside neighbour's --
// the same neighbour the fast anti-aliasing would have blended with. The
// crossing is interpolated towards the adjacent pixel of the same edge so a
// diagonal comes out as a line, not as steps. Interiors, textures and the
// 2D engines are untouched: only silhouettes and polygon boundaries change.
//
// `sx, sy`: the source pixel (at S x); `nx, ny` its native pixel; `fx, fy`
// this panel pixel's centre inside the native pixel, in [0, 1).
float edge_q(uint e) { return float(((e >> 3) & 31u) + 1u) / 32.0; }   // the covered fraction
// The crossing of the same edge in the adjacent row (Y-major) or column
// (X-major), `step` away: within one pixel along the other axis, since a
// major-axis slope moves less than a pixel a step. `found` false if the
// edge ends there (a vertex, or another polygon).
float edge_cross(uint kind, bool left, bool top, bool xmajor, int S, int W, int H, int sx, int sy, int step, out bool found) {
  found = false;
  if (!xmajor) {
    int qy = sy + step * S;
    if (qy < 0 || qy >= H) return 0.0;
    for (int k = -1; k <= 1; ++k) {
      int qx = sx + k * S;
      if (qx < 0 || qx >= W) continue;
      uint n = comp[uint(qy) * uint(W) + uint(qx)] >> 24;
      if (n == 0xFFu || (n & 7u) != kind) continue;
      found = true;
      return float(sx / S + k) + (left ? 1.0 - edge_q(n) : edge_q(n));
    }
  } else {
    int qx = sx + step * S;
    if (qx < 0 || qx >= W) return 0.0;
    for (int k = -1; k <= 1; ++k) {
      int qy = sy + k * S;
      if (qy < 0 || qy >= H) continue;
      uint n = comp[uint(qy) * uint(W) + uint(qx)] >> 24;
      if (n == 0xFFu || (n & 7u) != kind) continue;
      found = true;
      return float(sy / S + k) + (top ? edge_q(n) : 1.0 - edge_q(n));
    }
  }
  return 0.0;
}
// The edge through this pixel as a curve in the panel's resolution rather
// than a straight segment per DS pixel: a parabola through the crossings of
// the previous, this and the next row (or column). Three collinear
// crossings give the straight edge back exactly; at a vertex of the
// silhouette, where the slope changes, the curve bends through the corner
// across the two neighbouring DS pixels instead of taking it as a step --
// which is what makes a wheel of twelve edges read as round. With one
// neighbour missing (the edge ends) it is the linear interpolation towards
// the other; with both missing, a constant.
float edge_curve(float c0, bool fp, float cp, bool fn, float cn, float t) {   // t in [-0.5, 0.5): the position inside the pixel relative to its centre
  if (fp && fn) return c0 + t * 0.5 * (cn - cp) + t * t * 0.5 * (cn - 2.0 * c0 + cp);
  if (fn) return mix(c0, cn, max(t, 0.0));
  if (fp) return mix(c0, cp, max(-t, 0.0));
  return c0;
}
uint smooth_pick(uint s, int S, int W, int H, int sx, int sy, float fx, float fy) {
  uint e = s >> 24;
  if (e == 0xFFu) return s;
  int nx = sx / S, ny = sy / S;
  bool left = (e & 1u) == 0u, xmajor = (e & 2u) != 0u, top = (e & 4u) != 0u;
  uint kind = e & 7u;
  float q = edge_q(e);
  bool inside; int ox = 0, oy = 0;
  bool fp, fn;
  if (!xmajor) {
    // A near-vertical edge: the polygon is to the right of a left run's
    // crossing, to the left of a right run's.
    float c0 = float(nx) + (left ? 1.0 - q : q);
    float cp = edge_cross(kind, left, top, xmajor, S, W, H, sx, sy, -1, fp);
    float cn = edge_cross(kind, left, top, xmajor, S, W, H, sx, sy, 1, fn);
    float c = edge_curve(c0, fp, cp, fn, cn, fy - 0.5);
    float ax = float(nx) + fx;
    inside = left ? (ax >= c) : (ax < c);
    ox = left ? -1 : 1;
  } else {
    // A near-horizontal edge: the polygon is below the crossing when the
    // covered part is the bottom, above it otherwise.
    float c0 = float(ny) + (top ? q : 1.0 - q);
    float cp = edge_cross(kind, left, top, xmajor, S, W, H, sx, sy, -1, fp);
    float cn = edge_cross(kind, left, top, xmajor, S, W, H, sx, sy, 1, fn);
    float c = edge_curve(c0, fp, cp, fn, cn, fx - 0.5);
    float ay = float(ny) + fy;
    inside = top ? (ay < c) : (ay >= c);
    oy = top ? 1 : -1;
  }
  if (inside) return s;
  int px = clamp(sx + ox * S, 0, W - 1), py = clamp(sy + oy * S, 0, H - 1);
  return comp[uint(py) * uint(W) + uint(px)];
}

void main() {
  uvec2 p = gl_GlobalInvocationID.xy;
  if (p.x >= pc.a.x || p.y >= pc.a.y) return;
  int lw = int(pc.a.z), lh = int(pc.a.w), px = int(p.x), py = int(p.y), lx, ly;
  // The same convention as Display::rotate_out's transposes.
  if (pc.b.x == 90u)       { lx = py;          ly = lh - 1 - px; }
  else if (pc.b.x == 180u) { lx = lw - 1 - px; ly = lh - 1 - py; }
  else if (pc.b.x == 270u) { lx = lw - 1 - py; ly = px; }
  else                     { lx = px;          ly = py; }
  vec3 c = vec3(0.0);
  for (int v = 0; v < int(pc.b.y); ++v) {
    ivec4 r = pc.rect[v]; ivec4 vi = pc.view[v];
    if (vi.y == 0 || lx < r.x || ly < r.y || lx >= r.x + r.z || ly >= r.y + r.w) continue;
    uint s;
    if ((vi.w & 1) != 0) {   // the composited screen (engine A's)
      int S = int((pc.b.w >> 24) & 0x7Fu);
      int sx = (lx - r.x) * 256 * S / r.z, sy = (ly - r.y) * 192 * S / r.w;
      s = comp[uint(sy) * uint(256 * S) + uint(sx)];
      if ((pc.b.z & 0x200u) != 0u && (s >> 24) != 0xFFu) {   // an edge pixel of the smooth filter
        float fx = (float(lx - r.x) + 0.5) * 256.0 / float(r.z) - float(sx / S);
        float fy = (float(ly - r.y) + 0.5) * 192.0 / float(r.w) - float(sy / S);
        s = smooth_pick(s, S, 256 * S, 192 * S, sx, sy, fx, fy);
      }
    } else {
      int sx = (lx - r.x) * 256 / r.z, sy = (ly - r.y) * 192 / r.w;
      s = src[(pc.b.w & 0xFFFFFFu) + uint(vi.x) * 49152u + uint(sy) * 256u + uint(sx)];
    }
    vec3 col = vec3(float((s >> 16) & 255u), float((s >> 8) & 255u), float(s & 255u));
    uint gf = (pc.b.z >> 16) & 0x1FFu;
    // A seam: each channel (c * f) >> 8 as kern::dim_px has it, in floats (exact: c * f < 2^16), 0 at full strength.
    if (gf < 256u && (vi.w & 2) != 0 && (grid_seam(v, lx - r.x, 0) || grid_seam(v, ly - r.y, 1))) col = floor(col * (float(gf) / 256.0));
    col /= 255.0;
    c = (vi.z != 0 && (pc.b.z & 0xFFu) < 255u) ? mix(c, col, float(pc.b.z & 0xFFu) / 255.0) : col;
  }
  if ((pc.b.z & 0x100u) != 0u) {
    // Whatever the frontend drew on its canvas, over the picture: Display::blend_row's rule.
    uint ov = over[min(uint(ly) * uint(lw) + uint(lx), uint(lw * lh) - 1u)];
    uint oa = ov >> 24;
    if (oa != 0u) c = mix(c, vec3(float((ov >> 16) & 255u), float((ov >> 8) & 255u), float(ov & 255u)) / 255.0, float(oa) / 255.0);
  }
  imageStore(dst, ivec2(p), vec4(c, 1.0));
}
