#version 450
// P4 probe, pass 1 of the two-pass form: the luma plane (one float a pixel).
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer Src { uint src[]; };
layout(std430, binding = 1) writeonly buffer Lum { float lum[]; };
layout(push_constant) uniform P { int w, h; } pc;
void main() {
  uint i = gl_GlobalInvocationID.x; if (i >= uint(pc.w * pc.h)) return;
  uint c = src[i];
  lum[i] = (float((c >> 16) & 255u) * 0.299 + float((c >> 8) & 255u) * 0.587 + float(c & 255u) * 0.114) * (1.0 / 255.0);
}
