#version 450
// P0.1 import probe: one store per pixel into an IMPORTED dma-heap buffer,
// through a storage-buffer binding. The stride is the scanout buffer's.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) writeonly buffer Out { uint dst[]; };
layout(push_constant) uniform Push { uint w; uint h; uint stride_px; uint seed; } pc;
void main() {
  uvec2 p = gl_GlobalInvocationID.xy;
  if (p.x >= pc.w || p.y >= pc.h) return;
  dst[p.y * pc.stride_px + p.x] = 0xFF000000u | ((p.x + pc.seed) & 0xFFu) | ((p.y & 0xFFu) << 8) | (((p.x ^ p.y) & 0xFFu) << 16);
}
