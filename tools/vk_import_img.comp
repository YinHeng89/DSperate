#version 450
// P0.1 import probe: the same fill through a storage IMAGE bound to the
// imported dma-heap memory (LINEAR, DRM modifier 0).
layout(local_size_x = 16, local_size_y = 16) in;
layout(binding = 0, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform Push { uint w; uint h; uint stride_px; uint seed; } pc;
void main() {
  uvec2 p = gl_GlobalInvocationID.xy;
  if (p.x >= pc.w || p.y >= pc.h) return;
  // B8G8R8A8: component order in the shader is (r,g,b,a) of the format; we
  // write the same byte pattern the buffer arm writes (B = x, G = y, R = x^y).
  vec4 c = vec4(float((p.x ^ p.y) & 0xFFu), float(p.y & 0xFFu), float((p.x + pc.seed) & 0xFFu), 255.0) / 255.0;
  imageStore(dst, ivec2(p), c);
}
