#version 450
// Floor case: one store per pixel, no shading. Measures pure dispatch and
// round-trip overhead -- the cost a compute 3D raster pays before it does
// any work at all.
layout(local_size_x = 16, local_size_y = 16) in;
layout(std430, binding = 0) readonly  buffer In  { uint src[]; };
layout(std430, binding = 1) writeonly buffer Out { uint dst[]; };
layout(push_constant) uniform Push { uint w; uint h; uint work; } pc;

void main() {
  uvec2 p = gl_GlobalInvocationID.xy;
  if (p.x >= pc.w || p.y >= pc.h) return;
  dst[p.y * pc.w + p.x] = 0xFF000000u | (p.x & 0xFFu) | ((p.y & 0xFFu) << 8);
}
